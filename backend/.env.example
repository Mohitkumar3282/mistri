PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mistri_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Comma separated list of browser origins allowed to call this API.
# Leave empty to allow any origin. localhost:5173 is always permitted.
CLIENT_URL=http://localhost:5173

# Built-in administrator account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_deploying

# Development conveniences - leave unset (or false) in production.
# ALLOW_DEMO_LOGIN lets the seeded demo accounts sign in with DEMO_PASSWORD.
# ALLOW_SANDBOX_PAYMENTS accepts payments that carry no gateway signature.
ALLOW_DEMO_LOGIN=false
DEMO_PASSWORD=demo1234
ALLOW_SANDBOX_PAYMENTS=false

# Firebase web API key (the public VITE_FIREBASE_API_KEY) - verifies Google sign-in
FIREBASE_API_KEY=your_firebase_web_api_key

# Firebase Admin SDK service account (Firebase Console > Project Settings > Service
# accounts > Generate new private key). Lets the server send real push notifications.
# Keep FIREBASE_PRIVATE_KEY's \n sequences literal - do not unescape them in this file.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Cloud Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
